# PostgreSQL development database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_NAME_DEV=bau_cua_dev
DB_NAME_TEST=bau_cua_test

# Docker Compose PostgreSQL: set this password, use DB_PORT=5433,
# and set DB_PASSWORD to the same value. Native PostgreSQL uses port 5432.
# DOCKER_DB_PASSWORD=replace_with_your_docker_postgres_password

# Production can use one connection string instead of the DB_* variables.
# DATABASE_URL=postgresql://user:password@host:5432/bau_cua_dev

# Database tests prefer this URL when it is provided. The database name must
# clearly be a test database, for example bau_cua_test.
# TEST_DATABASE_URL=postgresql://user:password@host:5432/bau_cua_test

# HTTP / Socket.IO: PostgreSQL mode is the default; no automatic RAM fallback.
PORT=3000
# HOST=127.0.0.1
# ALLOWED_ORIGINS=https://your-domain.example

# Stable 32-byte base64url key. Generate with node:crypto.randomBytes(32).
# Required in production. Keep this key outside Git and back it up securely.
# MFA_ENCRYPTION_KEY=replace_with_a_generated_key

# Optional account email features; without these, email APIs return 503.
# PUBLIC_APP_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Bau Cua <no-reply@example.com>
# SMTP_USER=replace_with_smtp_username
# SMTP_PASSWORD=replace_with_smtp_password
